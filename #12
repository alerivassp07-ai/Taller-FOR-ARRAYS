using System;

namespace MyApplication
{
    class Program
    {
        static void Main(string[] args)
        {
            int altura = 5;

            for (int i = 1; i <= altura; i++)
            {
                for (int j = 1; j <= i; j++)
                {
                    Console.Write("*");
                }

                Console.WriteLine();
            }
        }
    }
}
