using System;

namespace MyApplication
{
    class Program
    {
        static void Main(string[] args)
        {
            int[] numeros = { 2, 4, 6, 4, 8 };

            for (int i = 0; i < numeros.Length; i++)
            {
                for (int j = i + 1; j < numeros.Length; j++)
                {
                    if (numeros[i] == numeros[j])
                    {
                        Console.WriteLine("Duplicado: " + numeros[i]);
                    }
                }
            }
        }
    }
}
