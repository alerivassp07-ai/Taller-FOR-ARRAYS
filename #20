using System;
using System.Linq;

namespace MyApplication
{
    class Program
    {
        static void Main(string[] args)
        {
            int[,] ventas =
            {
                {250, 180, 320},
                {400, 275, 150},
                {500, 350, 200}
            };

            int totalMes2 = 0;

            for (int j = 0; j < 3; j++)
            {
                totalMes2 += ventas[1, j];
            }

            Console.WriteLine("Total de ventas del mes 2: " + totalMes2);

            int maximo = ventas.Cast<int>().Max();

            Console.WriteLine("Venta mas alta: " + maximo);
        }
    }
}
